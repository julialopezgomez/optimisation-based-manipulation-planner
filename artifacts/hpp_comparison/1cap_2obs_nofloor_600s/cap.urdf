<?xml version="1.0"?>
<robot name="cap">
  <link name="base_link">
    <inertial><mass value="0.1"/><inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/></inertial>
  </link>
  <link name="cap_link">
    <inertial><mass value="0.1"/><inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/></inertial>
    <collision><origin xyz="0 0 0" rpy="0 -0 0"/><geometry><cylinder radius="0.024" length="0.005"/></geometry></collision>
    <collision><origin xyz="0 0 0" rpy="0 -0 0"/><geometry><cylinder radius="0.024" length="0.015"/></geometry></collision>
    <visual><origin xyz="0 0 0" rpy="0 -0 0"/><geometry><cylinder radius="0.025" length="0.005"/></geometry><material name="cap_link_0"><color rgba="0.5 0.5 0.5 0"/></material></visual>
    <visual><origin xyz="0 0 0" rpy="0 -0 0"/><geometry><cylinder radius="0.025" length="0.015"/></geometry><material name="cap_link_1"><color rgba="0 0 1 1"/></material></visual>
    <visual><origin xyz="0.013 0 0.0075" rpy="3.14159265 1.56759265 3.14159265"/><geometry><cylinder radius="0.001" length="0.024"/></geometry><material name="cap_link_2"><color rgba="1 0 0 1"/></material></visual>
  </link>
  <joint name="cap_to_base" type="revolute"><parent link="base_link"/><child link="cap_link"/><origin xyz="0 0 0" rpy="0 -0 0"/><axis xyz="0 0 1"/><limit lower="-3.14" upper="3.14" effort="100" velocity="2"/></joint>
</robot>
