<?xml version="1.0"?>
<sdf version="1.7">
  <!-- 3 x 3 x 0.1 m slab with its top at z = -0.01, just under the caps and the robot base.
       Weld its link at the world origin. HPP copy: experiments/hpp_comparison/scene/floor.urdf -->
  <model name="floor">
    <link name="floor_link">
      <visual name="floor_visual">
        <pose>0 0 -0.06 0 0 0</pose>
        <geometry><box><size>3 3 0.1</size></box></geometry>
        <material><diffuse>0.85 0.85 0.82 0.35</diffuse></material>
      </visual>
      <collision name="floor_collision">
        <pose>0 0 -0.06 0 0 0</pose>
        <geometry><box><size>3 3 0.1</size></box></geometry>
      </collision>
    </link>
  </model>
</sdf>
