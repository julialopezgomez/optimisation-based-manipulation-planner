<?xml version="1.0"?>
<!-- Copy of WALLS in multicap_scene.py, used by 8caps_3obs: update both together. Load at the identity pose.
     For a wall at angle a, running from r_in = 0.30 to r_out = 0.75 with height h:
       size = (r_out - r_in, thickness, h) = (0.45, 0.04, h)
       xyz  = (0.525 cos a, 0.525 sin a, h / 2)
       rpy  = (0, 0, a)
     front_wall: a = 0 deg, h = 0.35. left_wall: a = 102 deg, h = 0.50. right_wall: a = -102 deg, h = 0.50. -->
<robot name="walls">
  <link name="walls_link">
    <inertial>
      <mass value="1"/>
      <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/>
    </inertial>

    <visual>
      <origin xyz="0.525 0 0.175" rpy="0 0 0"/>
      <geometry><box size="0.45 0.04 0.35"/></geometry>
      <material name="wall_colour"><color rgba="0.55 0.45 0.35 0.6"/></material>
    </visual>
    <collision>
      <origin xyz="0.525 0 0.175" rpy="0 0 0"/>
      <geometry><box size="0.45 0.04 0.35"/></geometry>
    </collision>

    <visual>
      <origin xyz="-0.109153638 0.513527490 0.25" rpy="0 0 1.780235837"/>
      <geometry><box size="0.45 0.04 0.5"/></geometry>
      <material name="wall_colour"><color rgba="0.55 0.45 0.35 0.6"/></material>
    </visual>
    <collision>
      <origin xyz="-0.109153638 0.513527490 0.25" rpy="0 0 1.780235837"/>
      <geometry><box size="0.45 0.04 0.5"/></geometry>
    </collision>

    <visual>
      <origin xyz="-0.109153638 -0.513527490 0.25" rpy="0 0 -1.780235837"/>
      <geometry><box size="0.45 0.04 0.5"/></geometry>
      <material name="wall_colour"><color rgba="0.55 0.45 0.35 0.6"/></material>
    </visual>
    <collision>
      <origin xyz="-0.109153638 -0.513527490 0.25" rpy="0 0 -1.780235837"/>
      <geometry><box size="0.45 0.04 0.5"/></geometry>
    </collision>
  </link>
</robot>
